# Supabase Public Keys (safe for browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase Server-Only Secret (NEVER expose to browser, NEVER commit to git)
SUPABASE_SERVICE_ROLE_KEY=

# Dev only: your laptop LAN IP, so a phone on the same Wi-Fi can load the dev server (leave empty if not needed)
DEV_LAN_IP=
